			value="/pages-front/home/home.jsp" />
	</definition>
	
	<definition name="services" extends="frontBaseLayout">
		<put-attribute name="title" value="Services" />
		<put-attribute name="body"
			value="/pages-front/services/services.jsp" />
	</definition>
	
	<definition name="careers" extends="frontBaseLayout">
		<put-attribute name="title" value="Careers" />
		<put-attribute name="body"
			value="/pages-front/careers/careers.jsp" />
	</definition>
	<definition name="jobDetail" extends="frontBaseLayout">
		<put-attribute name="title" value=""/>
		<put-attribute name="body"
			value="/pages-front/careers/detail.jsp" />
	</definition>
	
		<!-- ARTICLE -->

	<definition name="blog" extends="frontBaseLayout">
		<put-attribute name="title" value="Blog" />
		<put-attribute name="body"
			value="/pages-front/blog/blog.jsp" />
	</definition>
	<definition name="blog.detail" extends="frontBaseLayout">
		<put-attribute name="title" value="" />
		<put-attribute name="body"
			value="/pages-front/blog/blog_detail.jsp" />
	</definition>
	<definition name="news" extends="frontBaseLayout">
		<put-attribute name="title" value="" />
		<put-attribute name="body"
			value="/pages-front/blog/blog.jsp" />
	</definition>
	
	<definition name="contacts" extends="frontBaseLayout">
		<put-attribute name="title" value="Contacts" />
		<put-attribute name="body"
			value="/pages-front/contacts/contacts.jsp" />
	</definition>

</tiles-definitions>