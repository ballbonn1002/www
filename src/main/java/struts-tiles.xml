<tiles-definitions>
	<!-- Front-End BASE LAYOUT -->
	
	<definition name="frontBaseLayout"
		template="/pages-front/_layout/baseLayout.jsp">
		<put-attribute name="title" value="Base Layout" />
		<put-attribute name="header"
			value="/pages-front/_layout/header.jsp" />
		<put-attribute name="body"
			value="/pages-front/_layout/body.jsp" />
		<put-attribute name="footer"
			value="/pages-front/_layout/footer.jsp" />
	</definition>
	
	<definition name="home" extends="frontBaseLayout">
		<put-attribute name="title" value="CubeSoftTech : Professional IT People, Innovative IT Solutions, Custom Software Solutions, Mobile Software Development, Software Development, IT Outsource" />
