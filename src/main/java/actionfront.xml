<!DOCTYPE struts PUBLIC
"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
"http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<constant name="struts.multipart.maxSize" value="30000000" />
			<!-- Article Front-->
		<package name="www" namespace="/" extends="default">
		<result-types>
			<result-type name="tiles"
				class="org.apache.struts2.views.tiles.TilesResult" />
		</result-types>
		
		<action name="services"
			class="com.cubesofttech.action.ServicesAction" method="init">
			<result name="success" type="tiles">services</result>
			<result name="error">/pages-front/index.jsp</result>
		</action>
		
		<action name="blog"
			class="com.cubesofttech.action.BlogAction" method="init">
			<result name="success">/pages-front/index.jsp</result>
			<result name="success" type="tiles">blog</result>
			<result name="error">/pages-front/index.jsp</result>
		</action>
		<action name="blog_detail"
			class="com.cubesofttech.action.BlogAction" method="blogDetail">
			<result name="success">/pages-front/index.jsp</result>
			<result name="success" type="tiles">blog.detail</result>
			<result name="error">/pages-front/index.jsp</result>
		</action>
		</package>

</struts>

