<!DOCTYPE struts PUBLIC
"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
"http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
    <constant name="struts.multipart.maxSize" value="30000000" />
    <!-- Article Front-->
    <package name="www" namespace="/" extends="default">
        <result-types>
            <result-type name="tiles" class="org.apache.struts2.views.tiles.TilesResult" />
        </result-types>
        
        <!-- Actions -->
        <!-- Internal redesign preview toggle - not linked anywhere in the UI.
             Both methods call response.sendRedirect() directly and return NONE,
             so no <result> mapping is needed (or safe to add - the response is
             already committed by the time Struts would try to render one). -->
        <action name="redesign-preview-on" class="com.cubesofttech.action.RedesignPreviewAction" method="on" />
        <action name="redesign-preview-off" class="com.cubesofttech.action.RedesignPreviewAction" method="off" />

        <action name="home" class="com.cubesofttech.action.HomeAction" method="init">
            <result name="success" type="tiles">home</result>
            <result name="error">/pages-front/index.jsp</result>
        </action>
        
        <action name="footer" class="com.cubesofttech.action.FooterAction" method="list">
            <result name="success" type="tiles">footer</result>
            <result name="error">/pages-front/index.jsp</result>
        </action>

        <action name="services" class="com.cubesofttech.action.ServicesAction" method="init">
            <result name="success" type="tiles">services</result>
            <result name="error">/pages-front/index.jsp</result>
        </action>

        <action name="software-development" class="com.cubesofttech.action.ServicesAction" method="init">
            <result name="success" type="tiles">software_dev</result>
            <result name="error">/pages-front/index.jsp</result>
        </action>
        
        <action name="it-outsource" class="com.cubesofttech.action.ServicesAction" method="init">
            <result name="success" type="tiles">it_outsource</result>
            <result name="error">/pages-front/index.jsp</result>
        </action>
        
        <action name="mobile-app-development" class="com.cubesofttech.action.ServicesAction" method="init">
            <result name="success" type="tiles">app_dev</result>
            <result name="error">/pages-front/index.jsp</result>
        </action>

        <action name="careers" class="com.cubesofttech.action.CareersAction" method="init">
            <result name="success" type="tiles">careers</result>
            <result name="error">/pages-front/index.jsp</result>
        </action>

        <action name="jobDetail" class="com.cubesofttech.action.CareersAction" method="jobDetail">
            <result name="success" type="tiles">jobDetail</result>
            <result name="error">/pages-front/index.jsp</result>
        </action>

        <action name="sendEmailJob" class="com.cubesofttech.action.CareersAction" method="sendEmailJob">
            <result name="success" type="tiles">jobDetail</result>
            <result name="error">/pages-front/index.jsp</result>
        </action>

        <action name="blog" class="com.cubesofttech.action.BlogAction" method="init">
            <result name="success" type="tiles">blog</result>
            <result name="redesign" type="tiles">blog.redesign</result>
            <result name="error">/pages-front/index.jsp</result>
        </action>

        <action name="blog_detail" class="com.cubesofttech.action.BlogAction" method="blogDetail">
            <result name="success" type="tiles">blog.detail</result>
            <result name="redesign" type="tiles">blog.detail.redesign</result>
            <result name="error">/pages-front/index.jsp</result>
        </action>

        <action name="news" class="com.cubesofttech.action.BlogAction" method="init">
            <result name="success" type="tiles">news</result>
            <result name="redesign" type="tiles">news.redesign</result>
            <result name="error">/pages-front/index.jsp</result>
        </action>

        <action name="contacts" class="com.cubesofttech.action.ContactsAction" method="init">
            <result name="success" type="tiles">contacts</result>
            <result name="error">/pages-front/index.jsp</result>
        </action>

        <action name="sendEmailContact" class="com.cubesofttech.action.ContactsAction" method="sendEmailContact">
            <result name="success" type="tiles">contacts</result>
            <result name="error">/pages-front/index.jsp</result>
        </action>
    </package>
</struts>
